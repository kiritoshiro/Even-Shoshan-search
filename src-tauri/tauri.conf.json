{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Even-Shoshan Search",
  "version": "0.1.2",
  "identifier": "io.github.kiritoshiro.evenshoshansearch",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Even-Shoshan Search",
        "width": 1280,
        "height": 860,
        "minWidth": 700,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Find words in the Even-Shoshan concordance",
    "copyright": "Code MIT. Lexicon data: STEPBible TBESH, CC BY 4.0.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
